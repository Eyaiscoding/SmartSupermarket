# =============================================================================
# Smart Supermarket B2G Platform - Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure for your environment
# Docker Compose will automatically load .env file

# =============================================================================
# KAFKA CONFIGURATION
# =============================================================================
# Kafka broker addresses (comma-separated for multiple brokers)
# Internal services use: kafka:9092
# External/host access: localhost:9093
KAFKA_BOOTSTRAP_SERVERS=localhost:9093

# Kafka topic retention policies (in milliseconds)
# 7 days = 604800000, 30 days = 2592000000, 1 year = 31536000000
KAFKA_RETENTION_MS_TELEMETRY=604800000
KAFKA_RETENTION_MS_PREDICTIONS=86400000
KAFKA_RETENTION_MS_DECISIONS=2592000000
KAFKA_RETENTION_MS_DISPATCH=2592000000
KAFKA_RETENTION_MS_COMPLIANCE=31536000000

# =============================================================================
# MQTT BROKER CONFIGURATION
# =============================================================================
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# =============================================================================
# TIMESCALEDB (PostgreSQL) CONFIGURATION
# =============================================================================
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=b2g
TIMESCALE_USER=b2g
TIMESCALE_PASSWORD=b2g_password
POSTGRES_DB=b2g
POSTGRES_USER=b2g
POSTGRES_PASSWORD=b2g_password

# =============================================================================
# REDIS CACHE CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=3600

# =============================================================================
# BACKEND API CONFIGURATION
# =============================================================================
# Data ingestion mode: csv, mqtt, or live
B2G_INGESTION_MODE=csv

# API server settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# FORECASTING SERVICE CONFIGURATION
# =============================================================================
# Path to training dataset (CSV)
TRAINING_DATA_PATH=/app/data/dataset.csv

# Model parameters
FORECASTING_HORIZON_HOURS=4
FORECASTING_MODEL_TYPE=gradient_boosting

# Anomaly detection sensitivity (0.0-1.0)
ANOMALY_CONTAMINATION=0.05

# =============================================================================
# MPC SERVICE CONFIGURATION
# =============================================================================
# MPC optimization horizon (hours)
MPC_HORIZON_HOURS=24
MPC_TIME_STEP_MINUTES=15

# Battery constraints
BATTERY_CAPACITY_KWH=200
BATTERY_MAX_CHARGE_KW=50
BATTERY_MAX_DISCHARGE_KW=50
BATTERY_SOC_MIN=10
BATTERY_SOC_MAX=95
BATTERY_EFFICIENCY=0.9

# Cost weights for MPC objective function
MPC_WEIGHT_ENERGY_COST=1.0
MPC_WEIGHT_SHEDDING_PENALTY=10.0
MPC_WEIGHT_COMFORT_PENALTY=5.0

# =============================================================================
# DERMS SERVICE CONFIGURATION
# =============================================================================
# Equipment control parameters
DERMS_RAMP_RATE_LIMIT_KW=10.0
DERMS_COMMAND_TIMEOUT_SEC=900

# =============================================================================
# COMPLIANCE SERVICE CONFIGURATION
# =============================================================================
# Compliance rules enforcement
COMPLIANCE_TIER1_PROTECTION_ENABLED=true
COMPLIANCE_LOG_VIOLATIONS=true
COMPLIANCE_MAX_LOGGED_VIOLATIONS=50

# Temperature limits (Celsius)
COLD_CHAIN_FREEZER_LIMIT_C=-18.0
COLD_CHAIN_CHILLER_LIMIT_C=4.0
COLD_CHAIN_TOLERANCE_C=0.0

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: text or json
LOG_FORMAT=json

# Enable structured logging with correlation IDs
ENABLE_CORRELATION_IDS=true

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================
# Health check intervals (seconds)
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# =============================================================================
# PRODUCTION DEPLOYMENT SETTINGS
# =============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Enable debug mode (DO NOT use in production)
DEBUG=false

# Restart policy: no, always, on-failure, unless-stopped
RESTART_POLICY=unless-stopped

# =============================================================================
# OPTIONAL: P2P TRADING CONFIGURATION (Phase 3)
# =============================================================================
# Enable P2P energy trading
B2G_P2P_ENABLED=false

# P2P dataset paths
B2G_SUPERMARKET_CSV=data1/dataset_modified.csv
B2G_NEIGHBORS_CSV=data1/smart_supermarket_neighbor_buildings_4months_15min1.csv

# =============================================================================
# NOTES
# =============================================================================
# - All paths are relative to the workspace root
# - Boolean values: true/false (lowercase)
# - Passwords should be changed in production
# - Redis password is optional (leave empty for no auth)
# - MQTT credentials are optional (leave empty for anonymous)
# - Kafka retention is in milliseconds
# - Temperature limits follow cold chain regulations
